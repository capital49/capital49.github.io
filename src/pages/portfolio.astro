---
import PageShell from "../layouts/PageShell.astro"
import { PORTFOLIO } from "../data/portfolio"

// The portfolio as a specimen table: one hairline grid, one mark per cell,
// every logo reduced to the same white the continuum is drawn in. The cell
// index picks up the page's tabular-numeral vernacular; the name and arrow
// only surface on approach.
---

<PageShell
  title="Portfolio — Capital 49"
  description="The Capital 49 portfolio — early-stage companies challenging the status quo across AI, enterprise platforms and fintech."
  eyebrow="07 — Portfolio"
  heading="Builders redefining what's possible"
  lede="Meet the founders who chose to build the future rather than wait for it."
>
  <section class="shell band">
    <ul class="grid">
      {
        PORTFOLIO.map((c, i) => (
          <li>
            <a class="cell" href={c.url} target="_blank" rel="noopener">
              <img
                src={c.src}
                alt={c.name}
                loading={i < 6 ? "eager" : "lazy"}
              />
              <span class="tag" aria-hidden="true">
                {String(i + 1).padStart(2, "0")} — {c.name}
              </span>
              <span class="out" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageShell>

<style>
  .band {
    padding-block: clamp(3.5rem, 8vh, 6rem) 0;
  }
  /* Each cell draws its own right and bottom hairline (the grid supplies the
     top and left outer edges), so slots left empty by the count stay bare. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }
  .grid li {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: #000;
    transition: background 0.5s ease;
  }
  .cell:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .cell img {
    height: clamp(1.5rem, 2.4vw, 2.1rem);
    width: auto;
    max-width: 62%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.62;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }
  /* Entangl's mark towers over its wordmark, so the lockup reads small at the
     shared height; give it a compensating bump. */
  .cell img[src*="entangl"] {
    height: calc(clamp(1.5rem, 2.4vw, 2.1rem) * 1.4);
  }
  .cell:hover img,
  .cell:focus-visible img {
    transform: scale(1.1);
    opacity: 1;
  }
  .tag {
    position: absolute;
    left: clamp(0.75rem, 1.4vw, 1.25rem);
    bottom: clamp(0.65rem, 1.2vw, 1.05rem);
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.4s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .out {
    position: absolute;
    right: clamp(0.75rem, 1.4vw, 1.25rem);
    top: clamp(0.65rem, 1.2vw, 1.05rem);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 0.4s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cell:hover .tag,
  .cell:hover .out,
  .cell:focus-visible .tag,
  .cell:focus-visible .out {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell {
      aspect-ratio: 4 / 3;
    }
    .cell img {
      height: clamp(1.35rem, 4vw, 1.75rem);
    }
    .cell img[src*="entangl"] {
      height: calc(clamp(1.35rem, 4vw, 1.75rem) * 1.4);
    }
    /* No hover on most small screens: keep the labels present. */
    .tag {
      opacity: 1;
      transform: none;
    }
  }
</style>

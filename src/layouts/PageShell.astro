---
import "../styles/global.css"
import { formatCoordinates, singleton } from "@/lib/content"

// Shared chrome for the inner pages. These pages continue the continuum of the
// homepage — same black field, same 7 x 7 lattice, same set-and-still type —
// but without the sculpture: the content is the object here.
//
// Each page opens with a numbered eyebrow that extends the homepage's section
// sequence (01–05 live on the index), and a title in the same treatment as the
// homepage headlines.

interface Props {
  title: string
  description: string
  eyebrow: string
  heading: string
  lede?: string
}

const { title, description, eyebrow, heading, lede } = Astro.props
const onTeam = Astro.url.pathname.startsWith("/team")
const site = await singleton("site")
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <div class="lattice" aria-hidden="true"></div>

    <header class="site-head">
      <a class="brand" href="/" aria-label="Capital 49 — home">
        <img
          class="brand-img"
          src="/logos/Capital49-logo-horizontal-black-trim.png"
          alt=""
          width="888"
          height="150"
        />
      </a>
      <a
        class="coords"
        href={site.mapUrl}
        target="_blank"
        rel="noopener">{formatCoordinates(site)}</a
      >
      <nav class="head-links" aria-label="Pages">
        <a href="/portfolio" data-active={String(!onTeam)}>Portfolio</a>
        <a href="/team" data-active={String(onTeam)}>Team</a>
        <a class="contact" href={`mailto:${site.contactEmail}`}>Contact</a>
      </nav>
    </header>

    <main>
      <section class="shell page-head">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="page-title">{heading}</h1>
        {lede && <p class="page-lede">{lede}</p>}
      </section>

      <slot />
    </main>

    <footer>
      <div class="shell foot-bar">
        <div class="foot-rule"></div>
        <div class="foot-row">
          <span class="meta">{site.footerNote}</span>
          <a
            class="foot-link"
            href={site.linkedin}
            target="_blank"
            rel="noopener">LinkedIn</a
          >
          <a class="foot-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
          <span class="meta">© 2026 Capital&nbsp;49</span>
        </div>
      </div>
    </footer>

    <style is:global>
      html {
        background: #000;
        scrollbar-width: none;
      }
      html::-webkit-scrollbar {
        display: none;
      }
      body {
        background: #000;
        color: #fff;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection {
        background: #fff;
        color: #000;
      }
      :focus-visible {
        outline: 1px solid rgba(255, 255, 255, 0.6);
        outline-offset: 4px;
      }

      /* ── Layers ─────────────────────────────────────────────────────── */
      .lattice {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: radial-gradient(
          circle at 0 0,
          rgba(255, 255, 255, 0.22) 1.1px,
          transparent 1.6px
        );
        background-size: calc(100% / 7) calc(100% / 7);
      }
      main,
      footer {
        position: relative;
        z-index: 10;
      }

      /* ── Header ─────────────────────────────────────────────────────── */
      .site-head {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 30;
        /* Opaque: scrolling copy passes behind the header, not through it. */
        background: linear-gradient(to bottom, #000 62%, rgba(0, 0, 0, 0));
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: clamp(1.1rem, 2.4vw, 1.9rem) clamp(1.25rem, 4.2vw, 4.5rem);
      }
      .brand {
        justify-self: start;
        display: inline-flex;
        align-items: center;
      }
      .brand-img {
        display: block;
        height: clamp(19px, 1.7vw, 25px);
        width: auto;
        filter: invert(1);
      }
      .coords {
        justify-self: center;
        font-size: clamp(0.8rem, 0.95vw, 0.95rem);
        color: rgba(255, 255, 255, 0.85);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        text-decoration: none;
        transition: color 0.35s ease;
      }
      .coords:hover {
        color: #fff;
      }
      .head-links {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: clamp(1.1rem, 2vw, 2rem);
      }
      .head-links a {
        font-size: clamp(0.8rem, 0.95vw, 0.95rem);
        text-decoration: none;
        color: rgba(255, 255, 255, 0.85);
        transition: color 0.35s ease;
      }
      .head-links a:hover {
        color: #fff;
      }
      .head-links a[data-active="true"] {
        color: #fff;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.4em;
      }

      /* ── Structure & type ───────────────────────────────────────────── */
      .shell {
        width: 100%;
        max-width: 1560px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4.2vw, 4.5rem);
      }
      .eyebrow {
        font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
        font-size: 0.6875rem;
        font-weight: 400;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.44);
        font-variant-numeric: tabular-nums;
      }
      .page-head {
        padding-top: clamp(7.5rem, 16vh, 11rem);
      }
      /* The homepage's .headline treatment, carried inward. */
      .page-title {
        margin: clamp(1rem, 1.8vw, 1.6rem) 0 0;
        font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
        font-weight: 300;
        font-size: clamp(2rem, 4.6vw, 4rem);
        line-height: 1;
        letter-spacing: -0.032em;
      }
      .page-lede {
        margin-top: clamp(1.75rem, 3.6vh, 2.75rem);
        font-size: clamp(0.95rem, 1vw, 1.125rem);
        line-height: 1.64;
        color: rgba(255, 255, 255, 0.6);
        max-width: 52ch;
        text-wrap: pretty;
      }

      /* ── Footer ─────────────────────────────────────────────────────── */
      .foot-rule {
        margin-top: clamp(5rem, 10vh, 8rem);
        height: 1px;
        background: rgba(255, 255, 255, 0.12);
      }
      .foot-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        align-items: baseline;
        justify-content: space-between;
        padding-block: clamp(1.25rem, 2.4vw, 1.75rem) clamp(1rem, 2vh, 1.5rem);
      }
      .foot-link {
        font-size: 0.6875rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        transition: color 0.4s ease;
      }
      .foot-link:hover {
        color: #fff;
      }
      .meta {
        font-size: 0.6875rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
      }

      /* Narrow headers: the page links keep their place; the coordinates go. */
      @media (max-width: 760px) {
        .site-head {
          grid-template-columns: 1fr auto;
        }
        .coords {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>

---
import PageShell from "../layouts/PageShell.astro"
import { TEAM, TEAM_INTRO, TEAM_TAGLINE } from "../data/team"

// Variation 3 — the folio. One spread per partner, portrait and text trading
// sides down the page the way the homepage copy zigzags around the sculpture.
// A ghost numeral sits behind each spread, printed at lattice scale.
---

<PageShell
  title="Team — Capital 49"
  description="The Capital 49 team — conviction-led, partnership-driven."
  eyebrow="07 — Team"
  heading="Conviction-led"
  lede={`${TEAM_TAGLINE} ${TEAM_INTRO}`}
>
  <section class="shell band">
    {
      TEAM.map((m, i) => (
        <article class:list={["spread", { flip: i % 2 === 1 }]}>
          <span class="ghost" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <figure class="frame">
            <img src={m.img} alt={m.name} loading="lazy" />
          </figure>
          <div class="copy">
            <p class="eyebrow">
              {String(i + 1).padStart(2, "0")} — {m.role}
            </p>
            <h2 class="name">{m.name}</h2>
            <p class="bio">{m.bio}</p>
          </div>
        </article>
      ))
    }
  </section>
</PageShell>

<style>
  .band {
    padding-block: clamp(2rem, 5vh, 4rem) 0;
  }
  /* The homepage's 7-column spine: portrait on 3, copy on 3, one clear
     column between. */
  .spread {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vh, 7rem);
  }
  .frame {
    grid-column: 1 / span 3;
    margin: 0;
    overflow: hidden;
  }
  .copy {
    grid-column: 5 / span 3;
  }
  .spread.flip .frame {
    grid-column: 5 / span 3;
  }
  .spread.flip .copy {
    grid-column: 1 / span 3;
    grid-row: 1;
  }
  .frame img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .spread:hover .frame img {
    transform: scale(1.03);
  }
  .ghost {
    position: absolute;
    top: 50%;
    z-index: -1;
    transform: translateY(-50%);
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-weight: 300;
    font-size: clamp(10rem, 26vw, 24rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.045);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    user-select: none;
  }
  .spread .ghost {
    right: 0;
  }
  .spread.flip .ghost {
    left: 0;
  }
  .name {
    margin: clamp(1rem, 1.8vw, 1.6rem) 0 0;
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-weight: 300;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.032em;
  }
  .bio {
    margin: clamp(1.5rem, 2.4vw, 2rem) 0 0;
    max-width: 48ch;
    font-size: clamp(0.9rem, 0.95vw, 1.0625rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .spread {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
      padding-block: clamp(2.75rem, 7vh, 4.5rem);
    }
    .spread .frame,
    .spread.flip .frame {
      grid-column: 1;
      max-width: min(420px, 78vw);
    }
    .spread .copy,
    .spread.flip .copy {
      grid-column: 1;
      grid-row: auto;
    }
    .ghost {
      font-size: clamp(8rem, 40vw, 14rem);
      top: 0;
      transform: none;
    }
  }
</style>

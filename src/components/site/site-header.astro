---
import { NAV_LINKS, SITE } from "@/content/site"

// Highlight the current route. Astro's trailingSlash default is "ignore", so
// normalise before comparing.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1")
---

<nav aria-label="Primary">
  <a href="/">{SITE.name}</a>
  {
    NAV_LINKS.map((link) => (
      <a
        href={link.href}
        aria-current={link.href === path ? "page" : undefined}
      >
        {link.label}
      </a>
    ))
  }
</nav>

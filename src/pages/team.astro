---
import PageShell from "../layouts/PageShell.astro"
import { TEAM, TEAM_INTRO, TEAM_TAGLINE } from "../data/team"

// The team page — a ledger crossed with a contact sheet: four hairline rows,
// each holding a portrait with the name and role beside it. Approach opens the
// row: the role slides out to the right rail, the name lifts, and the bio
// surfaces beneath it. Where hover doesn't exist, everything stays in view.
---

<PageShell
  title="Team — Capital 49"
  description="The Capital 49 team — conviction-led, partnership-driven."
  eyebrow="08 — Team"
  heading={TEAM_TAGLINE}
  lede={TEAM_INTRO}
>
  <section class="shell band">
    <ul class="members">
      {
        TEAM.map((m, i) => (
          <li class="member">
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <img class="portrait" src={m.img} alt={m.name} loading="lazy" />
            <div class="copy">
              <h2 class="name">{m.name}</h2>
              <span class="role">{m.role}</span>
              <p class="bio">{m.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</PageShell>

<style>
  .band {
    padding-block: clamp(3.5rem, 8vh, 6rem) 0;
  }
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .member {
    display: grid;
    grid-template-columns: clamp(2.5rem, 4vw, 4rem) auto minmax(0, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: start;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: clamp(1.75rem, 3.6vw, 3rem);
    transition: padding-left 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .member:hover {
    padding-left: clamp(0.5rem, 1.4vw, 1.25rem);
  }
  .idx {
    padding-top: 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.3);
    font-variant-numeric: tabular-nums;
  }
  .portrait {
    width: clamp(150px, 16vw, 220px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1);
  }
  /* At rest the row holds only the name with the role beneath it. On hover the
     role slides out to the right rail, the name lifts, and the bio surfaces. */
  .copy {
    position: relative;
  }
  .name {
    margin: 0;
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.72);
    transform: translateY(1.4rem);
    transition:
      color 0.4s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .member:hover .name {
    color: #fff;
    transform: none;
  }
  .bio {
    margin: clamp(1rem, 1.8vw, 1.5rem) 0 0;
    /* Never runs under the role, which now holds this height on the right. */
    max-width: min(52ch, calc(100% - 9rem));
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    text-wrap: pretty;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .member:hover .bio {
    opacity: 1;
    transform: none;
  }
  .role {
    position: absolute;
    left: 0;
    /* Below the rested (translated) name: its height plus the 1.4rem drop. */
    top: calc(clamp(1.75rem, 3.4vw, 3rem) * 1.05 + 1.9rem);
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.44);
    white-space: nowrap;
    transition:
      left 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .member:hover .role {
    left: 100%;
    transform: translateX(-100%);
  }

  /* No hover, no theatre: name, role and bio all stay in plain sight. */
  @media (hover: none) {
    .name,
    .member:hover .name {
      transform: none;
    }
    .role,
    .member:hover .role {
      position: static;
      display: block;
      margin-top: 0.75rem;
      transform: none;
    }
    .bio,
    .member:hover .bio {
      opacity: 1;
      transform: none;
      max-width: 52ch;
    }
  }

  @media (max-width: 760px) {
    .member {
      grid-template-columns: 1fr;
      row-gap: 1.25rem;
    }
    .idx {
      padding-top: 0;
      grid-row: 1;
    }
    .portrait {
      width: clamp(150px, 40vw, 220px);
    }
    .name,
    .member:hover .name {
      transform: none;
    }
    .role,
    .member:hover .role {
      position: static;
      display: block;
      margin-top: 0.75rem;
      transform: none;
    }
    .bio,
    .member:hover .bio {
      opacity: 1;
      transform: none;
      max-width: 52ch;
    }
  }
</style>

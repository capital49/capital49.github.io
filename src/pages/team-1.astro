---
import PageShell from "../layouts/PageShell.astro"
import { TEAM, TEAM_INTRO, TEAM_TAGLINE } from "../data/team"

// Variation 1 — the ledger. The team as an index: four hairline rows, name
// set large, role on the right margin. Approaching a row opens it — the bio
// and the portrait are filed inside. On touch screens every entry sits open.
---

<PageShell
  title="Team — Capital 49"
  description="The Capital 49 team — conviction-led, partnership-driven."
  eyebrow="07 — Team"
  heading="Conviction-led"
  lede={`${TEAM_TAGLINE} ${TEAM_INTRO}`}
>
  <section class="shell band">
    <ul class="members">
      {
        TEAM.map((m, i) => (
          <li class="member" tabindex="0">
            <div class="line">
              <span class="idx">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="name">{m.name}</h2>
              <span class="role">{m.role}</span>
            </div>
            <div class="body">
              <div class="inner">
                <p class="bio">{m.bio}</p>
                <img class="portrait" src={m.img} alt={m.name} loading="lazy" />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</PageShell>

<style>
  .band {
    padding-block: clamp(3.5rem, 8vh, 6rem) 0;
  }
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .member {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .line {
    display: grid;
    grid-template-columns: clamp(2.5rem, 4vw, 4rem) 1fr auto;
    align-items: baseline;
    padding-block: clamp(1.4rem, 3vw, 2.25rem);
    transition: padding-left 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .member:hover .line,
  .member:focus-within .line,
  .member:focus .line {
    padding-left: clamp(0.5rem, 1.4vw, 1.25rem);
  }
  .idx {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.3);
    font-variant-numeric: tabular-nums;
  }
  .name {
    margin: 0;
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 4.2vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.4s ease;
  }
  .member:hover .name,
  .member:focus-within .name,
  .member:focus .name {
    color: #fff;
  }
  .role {
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.44);
  }

  /* The drawer: 0fr -> 1fr keeps the collapse honest at any content height. */
  .body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .inner {
    overflow: hidden;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }
  .member:hover .body,
  .member:focus-within .body,
  .member:focus .body {
    grid-template-rows: 1fr;
  }
  .bio {
    margin: 0;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 52ch;
    font-size: clamp(0.875rem, 0.95vw, 1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    text-wrap: pretty;
  }
  .portrait {
    width: clamp(150px, 18vw, 240px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (max-width: 760px) {
    .role {
      display: none;
    }
    .inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .portrait {
      order: -1;
      margin-bottom: 0;
      width: clamp(150px, 40vw, 220px);
    }
    .bio {
      padding-top: 1.25rem;
    }
  }
  /* Without hover, the ledger sits open. */
  @media (hover: none) {
    .body {
      grid-template-rows: 1fr;
    }
    .name {
      color: #fff;
    }
  }
</style>

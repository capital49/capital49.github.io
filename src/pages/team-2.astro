---
import PageShell from "../layouts/PageShell.astro"
import { TEAM, TEAM_INTRO, TEAM_TAGLINE } from "../data/team"

// Variation 2 — the contact sheet. Four portraits in one hairline table, the
// same table the portfolio logos sit in. The bio is printed on the back of
// each portrait: hovering (or focusing) turns the print over. Touch screens
// get the bio beneath the portrait instead.
---

<PageShell
  title="Team — Capital 49"
  description="The Capital 49 team — conviction-led, partnership-driven."
  eyebrow="07 — Team"
  heading="Conviction-led"
  lede={`${TEAM_TAGLINE} ${TEAM_INTRO}`}
>
  <section class="shell band">
    <ul class="sheet">
      {
        TEAM.map((m, i) => (
          <li>
            <article class="card" tabindex="0">
              <figure class="frame">
                <img src={m.img} alt={m.name} loading="lazy" />
                <figcaption class="verso">
                  <p>{m.bio}</p>
                </figcaption>
              </figure>
              <p class="tag">
                {String(i + 1).padStart(2, "0")} — {m.role}
              </p>
              <h2 class="name">{m.name}</h2>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</PageShell>

<style>
  .band {
    padding-block: clamp(3.5rem, 8vh, 6rem) 0;
  }
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .card {
    height: 100%;
    background: #000;
    padding: clamp(1rem, 1.8vw, 1.75rem);
  }
  .frame {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .frame img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .frame img,
  .card:focus-visible .frame img {
    transform: scale(1.04);
  }
  .verso {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: clamp(0.9rem, 1.6vw, 1.4rem);
    background: rgba(0, 0, 0, 0.86);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .verso p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    text-wrap: pretty;
  }
  .card:hover .verso,
  .card:focus-visible .verso {
    opacity: 1;
  }
  .tag {
    margin: clamp(1rem, 1.8vw, 1.4rem) 0 0;
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.44);
    font-variant-numeric: tabular-nums;
  }
  .name {
    margin: 0.45rem 0 0;
    font-family: var(--font-heading, "IBM Plex Sans Variable", sans-serif);
    font-weight: 300;
    font-size: clamp(1.15rem, 1.6vw, 1.6rem);
    letter-spacing: -0.02em;
  }

  @media (max-width: 1023px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .sheet {
      grid-template-columns: 1fr;
    }
  }
  /* Without hover the back of the print can't be turned over: print the bio
     under the name instead. */
  @media (hover: none) {
    .verso {
      position: static;
      opacity: 1;
      background: none;
      padding: 0;
      margin-top: 0.9rem;
      order: 1;
    }
    .frame {
      display: flex;
      flex-direction: column;
    }
  }
</style>
